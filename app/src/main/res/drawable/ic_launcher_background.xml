<?xml version="1.0" encoding="utf-8"?>
<!-- 키드핵 런처 아이콘 배경. 전경(ic_launcher_foreground)은 흰 방패만 담고,
     이 배경이 아이콘 전체를 채우는 브랜드 주황(좌상 밝음 → 우하 진함 대각 그라디언트)이다.
     방패 속 사람 실루엣은 전경에서 뚫려 있어 이 배경 주황이 그대로 비친다. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#F98939"
                android:endColor="#F5711C" />
        </aapt:attr>
    </path>
</vector>
